{
  "name": "mcp-manager",
  "version": "1.0.0",
  "description": "Web dashboard to toggle MCP servers on/off, view tools, manage configs",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node server/index.js\" \"cd client && npx vite --port 5173\"",
    "build": "cd client && npx vite build --outDir ../dist",
    "start": "node server/index.js",
    "preview": "npm run build && npm start",
    "test": "vitest run --config client/vitest.config.js",
    "test:backend": "vitest run --config server/vitest.config.js",
    "test:all": "vitest run --config client/vitest.config.js && vitest run --config server/vitest.config.js",
    "test:watch": "vitest --config client/vitest.config.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "cors": "^2.8.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.1.0",
    "jsdom": "^28.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  }
}
