# MCP Manager — default configuration
# Copy this file to .env and modify values to override.

# Server
MCP_MANAGER_PORT=4111
MCP_MANAGER_LOG_FILE=$HOME/.mcp-manager.log
MCP_MANAGER_PID_FILE=$HOME/.mcp-manager.pid
MCP_MANAGER_STATE_FILE=$HOME/.mcp-manager-state.json

# Watchdog (auto-shutdown when no Claude sessions are alive)
MCP_MANAGER_WATCHDOG_INTERVAL_MS=5000
MCP_MANAGER_GRACE_CHECKS=2

# Tool prober cache
MCP_MANAGER_TOOL_CACHE_TTL_MS=300000

# Tool probe timeout (ms) — how long to wait for a server to respond during probing
MCP_MANAGER_PROBE_TIMEOUT_MS=15000

# Health check timeout (seconds, used by start/stop scripts)
MCP_MANAGER_HEALTH_TIMEOUT=2

# Max seconds to wait for server to become ready on startup
MCP_MANAGER_STARTUP_WAIT=5

# Frontend polling interval (ms)
MCP_MANAGER_POLL_INTERVAL_MS=5000
